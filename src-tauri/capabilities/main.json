{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The embedded main window uses the semantic dispatcher; native drag regions may only drag or toggle maximize.",
  "windows": ["main"],
  "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "allow-toolbox-dispatch", "core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"]
}
