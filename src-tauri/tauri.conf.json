{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "物理世界的工具箱",
  "version": "0.4.0",
  "identifier": "com.physicalworld.toolbox",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "物理世界的工具箱",
      "width": 1420,
      "height": 900,
      "minWidth": 640,
      "minHeight": 440,
      "decorations": false,
      "resizable": true,
      "shadow": true,
      "center": true,
      "visible": false,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
